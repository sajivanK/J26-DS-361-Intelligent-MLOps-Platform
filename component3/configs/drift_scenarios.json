{
  "experiment_name": "sprint02_uci_adult_controlled_drift",
  "dataset": "uci_adult",
  "reference_path": "shared/uci_adult/data/reference.csv",
  "model_path": "shared/uci_adult/models/base_model_adult.pkl",
  "target_col": "target",
  "batch_size": 6000,
  "seed": 42,
  "feature_types": {
    "age": "continuous",
    "education_num": "continuous",
    "capital_gain": "continuous",
    "capital_loss": "continuous",
    "hours_per_week": "continuous",
    "workclass": "categorical",
    "marital_status": "categorical",
    "occupation": "categorical",
    "relationship": "categorical",
    "race": "categorical",
    "sex": "categorical",
    "native_country": "categorical"
  },
  "scenarios": [
    {
      "id": "S00",
      "name": "no_drift_baseline",
      "drift_type": "none",
      "features": [],
      "magnitude": 0.0,
      "interaction_pairs": []
    },
    {
      "id": "S01",
      "name": "high_importance_numerical",
      "drift_type": "marginal_single",
      "features": ["age"],
      "magnitude": 0.4,
      "interaction_pairs": []
    },
    {
      "id": "S02",
      "name": "low_importance_numerical",
      "drift_type": "marginal_single",
      "features": ["capital_loss"],
      "magnitude": 0.4,
      "interaction_pairs": []
    },
    {
      "id": "S03",
      "name": "high_importance_categorical",
      "drift_type": "marginal_single",
      "features": ["marital_status"],
      "magnitude": 0.4,
      "interaction_pairs": []
    },
    {
      "id": "S04",
      "name": "low_importance_categorical",
      "drift_type": "marginal_single",
      "features": ["race"],
      "magnitude": 0.4,
      "interaction_pairs": []
    },
    {
      "id": "S05",
      "name": "multiple_numerical_features",
      "drift_type": "marginal_multi",
      "features": ["age", "education_num"],
      "magnitude": 0.6,
      "interaction_pairs": []
    },
    {
      "id": "S06",
      "name": "feature_interaction",
      "drift_type": "interaction",
      "features": ["marital_status", "relationship"],
      "magnitude": 0.6,
      "interaction_pairs": [
        ["marital_status", "relationship"]
      ]
    },
    {
      "id": "S07",
      "name": "combined_feature_drift",
      "drift_type": "combined",
      "features": ["age"],
      "magnitude": 0.6,
      "interaction_pairs": [
        ["marital_status", "relationship"]
      ]
    }
  ]
}
